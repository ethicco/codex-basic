{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/eslint.sh"
          },
          {
            "type": "command",
            "command": ".codex/hooks/gofmt.sh"
          }
        ]
      }
    ]
  }
}
